# Copiar a /etc/gateway.env y ajustar. systemd lo carga al arrancar.
GATEWAY_PORT=8080

# Microservicios (uno por ruta del application.yml)
SALUDO_URL=http://127.0.0.1:8081

# Origenes permitidos por CORS (separados por coma). Si usas Nginx con /api no hace falta.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seguridad JWT: false = todo abierto
SECURITY_ENABLED=false
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-minimo-32-caracteres
PUBLIC_PATHS=/actuator/health
